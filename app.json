{
  "expo": {
    "name": "JobsRack",
    "slug": "jobsrack",
    "scheme": "jobsrack",
    "version": "1.3.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#13213C"
    },
    "ios": {
      "bundleIdentifier": "com.jobsrack.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.jobsrack.app",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#13213C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#1F7A4D"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "ankurindozs-team",
    "extra": {
      "eas": {
        "projectId": "c6d9c6f6-5062-431c-bc31-0191358793cc"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/c6d9c6f6-5062-431c-bc31-0191358793cc"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}